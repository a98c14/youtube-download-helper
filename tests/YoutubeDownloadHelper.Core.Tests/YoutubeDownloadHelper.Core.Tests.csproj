<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YoutubeDownloadHelper.Contracts\YoutubeDownloadHelper.Contracts.csproj" />
    <ProjectReference Include="..\..\src\YoutubeDownloadHelper.Core\YoutubeDownloadHelper.Core.csproj" />
    <!-- Copies YoutubeDownloadHelper.FakeYtDlp.exe next to the tests. -->
    <ProjectReference Include="..\..\tools\YoutubeDownloadHelper.FakeYtDlp\YoutubeDownloadHelper.FakeYtDlp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FakeTimeProvider: timers that tests advance by hand (the progress throttle). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CultureCanaryTests.cs" Link="Shared\CultureCanaryTests.cs" />
    <Compile Include="..\Shared\Approval.cs" Link="Shared\Approval.cs" />
    <Compile Include="..\Shared\FakeToolFeed.cs" Link="Shared\FakeToolFeed.cs" />
    <!-- yt-dlp output samples for the error classifier; see fixtures.json for where each came from. -->
    <None Include="Errors\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Spike #33's raw yt-dlp captures, for the progress parser. -->
    <None Include="..\..\docs\spikes\samples\*.txt" LinkBase="Runner\Samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
