<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike for issue #31. Not part of the solution. -->
  <PropertyGroup>
    <!-- Exe (not WinExe) so a console window shows the log next to the browser window. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebView2Login</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
