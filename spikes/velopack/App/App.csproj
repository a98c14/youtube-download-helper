<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike for issue #32. Not part of the solution. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK TFM for the WinRT toast APIs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>App</AssemblyName>
    <RootNamespace>VelopackSpike.App</RootNamespace>
    <StartupObject>VelopackSpike.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local update feed, passed by build.ps1. -->
    <AssemblyMetadata Include="FeedPath" Value="$(FeedPath)" />
  </ItemGroup>

</Project>
