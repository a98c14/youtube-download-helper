<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine logic. Windows-only APIs (Job Objects, DPAPI, file ACLs, named mutexes), but no ASP.NET and no UI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YoutubeDownloadHelper.Contracts\YoutubeDownloadHelper.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Design-time only (dotnet ef migrations). PrivateAssets keeps it out of Engine's dependency graph. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
